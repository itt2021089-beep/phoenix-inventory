# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
# Only the PUBLISHABLE key (the "anon" key on older projects) belongs here.
# The secret key (service_role) must never be in this repo, in the frontend, or in a chat.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The deployed app URL, used inside QR codes (no trailing slash). e.g. https://inventory.pages.dev
VITE_PUBLIC_APP_URL=
