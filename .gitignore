# dependencies and builds
node_modules/
dist/
dev-dist/
*.log

# secrets: only .env.example is committed
.env
.env.local
.env.test.local
.env.*
!.env.example

# real company data (staff names, NIDs): never commit.
# data/* (not data/) so the two negations below can take effect: git does not look inside a
# directory it has excluded outright. Those two files are already tracked and stay that way --
# Sahan's call, and the repo is private. Anything else dropped in data/ (exports, backups) and
# every other .xlsx is ignored.
data/*
*.xlsx
!tests/fixtures/*.xlsx
!data/README.txt
!data/IT_Asset_Inventory_Phoenix_BPO.xlsx

# supabase cli
supabase/.temp/
supabase/.branches/

# os / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
