# Cloudflare Pages applies these to every response (docs: pages.cloudflare.com -> headers).
# What each one is for:
#   Content-Security-Policy   the page may only run its own scripts, and may only talk to its own
#                             site and Supabase. Even if some text were ever slipped into a page,
#                             it could not load a script from elsewhere or send data to a stranger.
#   frame-ancestors / X-Frame-Options   nobody can put the app inside another site's page.
#   X-Content-Type-Options    the browser must not guess file types.
#   Referrer-Policy           a link out of the app does not carry the address (which has a tag).
#   Permissions-Policy        the app asks for nothing but the camera (to photograph a fault).
# img-src and connect-src name every Supabase project (*.supabase.co): DEV, PROD and the signed
# photo links. If the app is ever moved to a custom Supabase domain, add it here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Files with a hashed name never change, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the page that starts the app must always be fresh, or an update
# would not reach people.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
